# Copia este archivo a .env y completa los valores.
# Lo carga automáticamente `npm run server` y `npm run reminders`
# (node --env-file-if-exists=.env) y el servicio systemd (EnvironmentFile).

# --- Servidor ---
# Puerto del backend Express (por defecto: 4324)
PORT=4324
# Zona horaria para el cálculo de fechas/recordatorios (por defecto: America/Bogota)
TIME_ZONE=America/Bogota

# --- Correo (Gmail / SMTP) ---
# Cuenta de Gmail usada como remitente
GMAIL_USER=tucorreo@gmail.com
# Contraseña de aplicación de Google (NO la contraseña normal):
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Dirección que recibe las notificaciones de nuevos registros/contactos
NOTIFY_EMAIL=tucorreo@gmail.com

# --- Autenticación de endpoints de administración ---
# Clave requerida por los endpoints /api/... de administración y por `npm run reminders`
ADM_KEY=cambia-esta-clave

# --- Script de recordatorios (scripts/send-reminders.js) ---
# Slug del evento por defecto si no se pasa como argumento
EVENT_SLUG=introduccion-programacion
# URL base del backend al que el script llama (por defecto: http://localhost:4324)
REMINDER_API_URL=http://localhost:4324
